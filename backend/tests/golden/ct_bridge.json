    },
    {
      "name": "loss period adds to losses carried forward",
      "inputs": [
        {"key": "accounting_profit", "amount": "-200000"},
        {"key": "losses_brought_forward", "amount": "100000"}
      ],
      "worked": [
        "adjusted = -200000; no interest; before losses = -200000",
