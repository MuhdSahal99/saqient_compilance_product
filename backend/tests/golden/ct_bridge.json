{
  "formula": "corporate_tax",
  "prefix": "syn.ct",
  "rules": "app/demo_tax.py ct_rules() (synthetic): bands 0-400000 at 0, above at 0.12; entertainment share 0.40; interest share 0.25, de minimis 200000; loss cap 0.70; 2 decimals half_up",
  "cases": [
    {
      "name": "add-backs, entertainment, exempt income, related party, interest limited, losses used in full",
      "inputs": [
        {"key": "accounting_profit", "amount": "1000000"},
        {"key": "fines", "category": "non_deductible", "amount": "20000"},
