        {"key": "dividends", "category": "exempt_income", "amount": "50000"},
        {"key": "tp_adjustment", "category": "related_party", "amount": "12000"},
        {"key": "net_interest_expense", "amount": "400000"},
        {"key": "depreciation_amortisation", "amount": "100000"},
        {"key": "losses_brought_forward", "amount": "300000"}
      ],
      "worked": [
        "entertainment disallowed = 30000 x (1 - 0.40) = 18000",
        "adjusted = 1000000 + 20000 + 18000 + 12000 - 50000 = 1000000",
        "tax EBITDA = 1000000 + 400000 + 100000 = 1500000",
        "capacity = max(200000, 0.25 x 1500000) = 375000; disallowed = 400000 - 375000 = 25000",
        "before losses = 1000000 + 25000 = 1025000; cap = 0.70 x 1025000 = 717500, so all 300000 used",
        "taxable income = 725000; tax = (725000 - 400000) x 0.12 = 39000"
      ],
      "expected": {
        "entertainment_disallowed": "18000.00",
        "adjusted_profit": "1000000",
        "tax_ebitda": "1500000",
        "interest_capacity": "375000.00",
        "interest_disallowed": "25000.00",
        "interest_brought_forward_used": "0",
        "interest_carried_forward": "25000.00",
        "taxable_income_before_losses": "1025000.00",
        "losses_used": "300000.00",
        "losses_carried_forward": "0.00",
        "taxable_income": "725000.00",
        "tax": "39000.00"
      }
    },
    {
      "name": "brought-forward interest used, loss cap binds, rounding of the cap",
      "inputs": [
        {"key": "accounting_profit", "amount": "500000"},
        {"key": "team_event", "category": "entertainment", "amount": "1234.57"},
        {"key": "net_interest_expense", "amount": "50000"},
