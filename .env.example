# Copy to .env for local development. Never commit real values.
APP_ENV=development                 # development | test | production
SECRET_KEY=change-me-in-production  # production startup refuses this value
# Field-level encryption (TRN etc.): 32 random bytes, base64. Required in production.
# Generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
DEMO_MODE=true                      # synthetic demo users can log in only when true (never in production)

DATABASE_URL=postgresql+psycopg://saqient:saqient@localhost:5432/saqient
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false      # true runs jobs in-process (no worker); dev/test only

CORS_ORIGINS=http://localhost:5173
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false                 # must be true in production

STORAGE_BACKEND=local               # local | s3 | gcs
STORAGE_LOCAL_PATH=./storage
# S3-compatible (optional)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
# Google Cloud Storage (optional)
GCS_BUCKET=

MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
MAX_EXTRACTED_CHARS=2000000
PROCESSING_TIME_LIMIT_SECONDS=120

# AI is disabled. See docs/MODEL_INTEGRATION.md before changing anything below.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_AUTH=api_key                    # api_key | google (service account) | google_api_key (Vertex AI key)
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=800
AI_ALLOWED_HOSTS=
AI_ALLOW_INSECURE_HTTP=false       # http only to an allowlisted private host (compose "inference")
AI_SERVING_INTERFACE_VERIFIED=false

# Finance dataset imports
DATASET_MAX_UPLOAD_MB=100
DATASET_MAX_ROWS=1000000

# Email (invitations, password reset, task due-date reminders)
APP_BASE_URL=http://localhost:5173  # public web URL used in email links; https in production
MAIL_BACKEND=file                   # file (dev: .eml files in MAIL_FILE_DIR) | smtp | disabled
MAIL_FILE_DIR=./var/mail
MAIL_FROM=Saqient <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
REMINDER_DAYS_AHEAD=3               # daily reminder covers tasks due within this many days

# OCR for PDF pages without a text layer (local Tesseract; images never leave the host)
OCR_PROVIDER=disabled               # disabled | tesseract (compose: build with INSTALL_TESSERACT=true)
OCR_LANGUAGES=eng+ara
OCR_DPI=200
OCR_MAX_PAGES=50
OCR_PAGE_TIMEOUT_SECONDS=60

# Malware scanning of uploads (clamd INSTREAM); compose: --profile clamav
MALWARE_SCAN=disabled               # disabled | clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
MALWARE_SCAN_FAIL_OPEN=false        # true accepts uploads while the scanner is down (not advised)
